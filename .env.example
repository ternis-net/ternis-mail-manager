# Ternis Mail Manager - Environment Configuration Example

# Server Hostname and URLs
MAIL_HOST=one.mx.ternis.net
WEBMAIL_URL=https://one.webmail.ternis.net
API_HOST=127.0.0.1
API_PORT=8088

# Storage and DKIM paths
MAIL_STORAGE=/var/vmail
DKIM_DIR=/var/lib/rspamd/dkim
TOKENS_FILE=/etc/mail-secrets/api-tokens.json

# Database Connection (MariaDB / MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vmail
DB_PASSWORD=your_secure_db_password
DB_NAME=vmail

# Or path to standard MySQL my.cnf / mysql-vmail.cnf
# MYSQL_CNF_FILE=/etc/mail-secrets/mysql-vmail.cnf

# Outgoing SMTP for Postmaster Verification Emails
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_FROM_EMAIL=noreply@one.mx.ternis.net
